# Backend (cockpit) environment — copy to ../.env or export in your shell.
# All services bind to localhost by default. Do NOT expose publicly.

# API server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Encryption key for the local secret store (data/secrets.enc).
# If unset, a key is auto-generated at data/secret.key (owner-only).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRADER_SECRET_KEY=

# IBKR TWS socket connection is configured in app/config/defaults.yaml
# (broker.host / broker.paper_port / broker.live_port / broker.client_id).
