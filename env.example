# Alpha Vantage API (Required for market data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# OpenAI API (Required for AI trading recommendations)
OPENAI_API_KEY=your_openai_api_key_here

# IB Gateway/TWS Connection (Optional - only needed for live trading)
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# Trading Settings
DRY_RUN=true
MAX_DOLLARS_PER_TRADE=1000.0
CONFIDENCE_THRESHOLD=0.7
TRADING_INTERVAL_SECONDS=60

# Optional: IB Credentials for Gateway Container
TWS_USERID=
TWS_PASSWORD=

# Optional: AI Mock Mode (for testing without OpenAI API calls)
USE_MOCK_AI=false

# Logging
LOG_LEVEL=INFO
