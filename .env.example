# Interactive Brokers Settings
IB_HOST=127.0.0.1
IB_PORT=7497  # 7497 for paper trading, 7496 for live
IB_CLIENT_ID=1

# Gemini AI Settings
GEMINI_API_KEY=your-gemini-api-key-here

# Trading Settings
DRY_RUN=true  # Set to false to enable real trading
MAX_POSITION_SIZE=100  # Maximum shares per trade
CONFIDENCE_THRESHOLD=0.7  # Minimum AI confidence to execute
TRADING_INTERVAL_SECONDS=300  # Time between trading cycles (5 min)

# Logging
LOG_LEVEL=INFO
