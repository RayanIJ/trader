# Copy to .env before: docker compose up -d
# Required for IB Gateway container login:
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password
TRADING_MODE=live
VNC_PASSWORD=123456

# Cockpit backend (override defaults in docker-compose.yml)
LOG_LEVEL=INFO
MARKET_DATA_SOURCE=tws
IB_CLIENT_ID=2

# Legacy vars (ignored by cockpit unless you run docker-compose.legacy.yml)
DRY_RUN=true
